# ============================================================
# CAMPUSCONNECT — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# NEVER COMMIT .env.local TO VERSION CONTROL
# ============================================================

# ------------------------------------------------------------
# SUPABASE (Required)
# ------------------------------------------------------------
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key

# SERVICE ROLE KEY - SERVER ONLY - NEVER EXPOSE TO CLIENT
# Get this from: https://supabase.com/dashboard/project/_/settings/api
# Keep this secret! It has full database access bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# CAMPUSCONNECT AI — SERVER ONLY
# ------------------------------------------------------------
# Groq API (Free tier): https://console.groq.com/keys
AI_CHAT_COMPLETIONS_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=gsk_your_groq_api_key
AI_MODEL=openai/gpt-oss-20b

# Optional: Dedicated vision model for syllabus/timetable scanning
# SYLLABUS_VISION_MODEL=qwen/qwen3.8-27b
# TIMETABLE_VISION_MODEL=qwen/qwen3.8-27b

# Optional cost calculation (per million tokens)
AI_INPUT_COST_PER_1M=0
AI_OUTPUT_COST_PER_1M=0

# ------------------------------------------------------------
# EMAIL (Resend) — SERVER ONLY
# ------------------------------------------------------------
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Verified sender email in Resend
ATTENDANCE_EMAIL_FROM=CampusConnect <noreply@yourdomain.com>

# ------------------------------------------------------------
# INTERNAL WORKER AUTHENTICATION — SERVER ONLY
# ------------------------------------------------------------
# Generate a strong random secret: openssl rand -base64 32
# Used by attendance email delivery worker
ATTENDANCE_DELIVERY_WORKER_SECRET=

# Enable/disable automatic attendance email delivery
ATTENDANCE_EMAIL_DELIVERY_ENABLED=false

# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------
# Your production URL (for CORS, CSP, etc.)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ------------------------------------------------------------
# DEVELOPMENT OVERRIDES (Optional)
# ------------------------------------------------------------
# Uncomment for local development with different values
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key