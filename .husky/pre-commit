#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# CampusConnect Pre-commit Security Checks

echo "🔒 Running pre-commit security checks..."

# 1. Check added lines for hardcoded credentials
echo "  Checking for secrets..."
python3 - <<'PYSCAN'
import re
import subprocess
import sys

diff = subprocess.run(
    ["git", "diff", "--cached", "--no-ext-diff", "--unified=0", "--"],
    capture_output=True, text=True, check=True
).stdout

# Only flag direct assignments of long string literals to secret-like variables.
assignment = re.compile(
    r"""^\+\s*(?:(?:export|const|let|var)\s+)?"""
    r"""[A-Za-z_$][\w$]*(?:api[_-]?key|secret|password|token)[\w$]*"""
    r"""\s*=\s*(['"])([A-Za-z0-9_/-]{24,})\1\s*;?\s*$""",
    re.IGNORECASE,
)

# Ignore diff metadata and inspect added source lines only.
matches = []
for line in diff.splitlines():
    if line.startswith("+++") or not line.startswith("+"):
        continue
    if assignment.search(line):
        matches.append(line)

if matches:
    print("Potential hardcoded credential found in staged additions:")
    for line in matches:
        print(line)
    print("Use an environment variable instead.")
    sys.exit(1)

print("No direct hardcoded credential assignments detected.")
PYSCAN
if [ "$?" -ne 0 ]; then
  echo "❌ ERROR: Potential hardcoded credential detected in staged changes!"
  exit 1
fi

# 2. Check for .env.local in staged files
if git diff --cached --name-only | grep -q "^\.env\.local$"; then
  echo "❌ ERROR: .env.local should not be committed!"
  echo "   Run: git restore --staged .env.local"
  exit 1
fi

# 3. Run lint only on files that differ from HEAD — staged copies of unchanged worktrees would otherwise fail.
echo "  Running linter..."
staged_ts_files=$(git diff --cached --name-only -- '*.ts' '*.tsx' '*.js' '*.jsx' 2>/dev/null)
if [ -n "$staged_ts_files" ]; then
  unique_changed_ts_files=""
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    git diff --quiet HEAD -- "$f" && continue
    unique_changed_ts_files="${unique_changed_ts_files} ${f}"
  done <<< "$staged_ts_files"
  if [ -n "$unique_changed_ts_files" ]; then
    echo "$unique_changed_ts_files" | xargs npx eslint --max-warnings=0 2>/dev/null || {
      echo "❌ Linting failed. Fix errors before committing."
      exit 1
    }
  fi
fi

# 4. Check for console.log in production code (non-test files)
echo "  Checking for console.log..."
staged_ts_only=$(git diff --cached --name-only -- '*.ts' '*.tsx' 2>/dev/null)
if [ -n "$staged_ts_only" ]; then
  echo "$staged_ts_only" | xargs grep -l "console\.log" 2>/dev/null | grep -v "\.test\." | grep -v "\.spec\." && {
    echo "⚠️  WARNING: console.log found in non-test files"
    echo "   Consider removing or using proper logging."
  }
fi

echo "✅ Pre-commit checks passed"
