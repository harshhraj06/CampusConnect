{
  "name": "campusconnect-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:check": "npm run security:scan && npx tsc --noEmit && npm run security:audit",
    "security:secrets": "git secrets --scan || true",
    "prepare": "husky",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.7.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.3",
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "base64-js": "1.5.1",
    "brotli": "1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.4.6",
    "gsap": "^3.15.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "next": "^16.3.8",
    "ogl": "^1.0.11",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "unicode-properties": "1.4.1",
    "unicode-trie": "2.0.0",
    "unpdf": "^1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0",
    "vite": "^8.3.2",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "@vitejs/plugin-rsc": {
      "@rolldown/pluginutils": "1.0.1"
    }
  },
  "type": "module",
  "displayName": "CampusConnect Pro"
}
